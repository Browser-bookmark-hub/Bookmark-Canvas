{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "author": "kk1",
  "icons": {
    "100": "icons/icon200.png"
  },
  "action": {
    "default_icon": {
      "200": "icons/icon200.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "panel-shell.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Option+Shift+A",
        "windows": "Alt+Shift+A",
        "linux": "Alt+Shift+A"
      }
    },
    "open_canvas_view": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Option+Shift+S",
        "windows": "Alt+Shift+S",
        "linux": "Alt+Shift+S"
      },
      "description": "__MSG_commandOpenCanvasView__"
    }
  },
  "permissions": [
    "sidePanel",
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "tabGroups",
    "windows",
    "commands",
    "activeTab",
    "favicon",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "icons/icon200.png",
        "history_html/*"
      ]
    }
  ]
}
