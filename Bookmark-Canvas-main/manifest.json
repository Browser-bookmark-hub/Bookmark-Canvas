{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extensionName__",
  "version": "1.0.2",
  "description": "__MSG_extensionDescription__",
  "author": "kk1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "panel-shell.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X",
        "windows": "Ctrl+Shift+X",
        "linux": "Ctrl+Shift+X"
      }
    },
    "open_canvas_view": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space",
        "windows": "Ctrl+Shift+Space",
        "linux": "Ctrl+Shift+Space"
      },
      "description": "__MSG_commandOpenCanvasView__"
    }
  },
  "permissions": [
    "sidePanel",
    "bookmarks",
    "storage",
    "clipboardWrite",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "tabGroups",
    "windows",
    "commands",
    "activeTab",
    "favicon",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "icons/icon16.png",
        "icons/icon24.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "history_html/*"
      ]
    }
  ]
}